# Newlines are declared here rather than left to a clone's core.autocrlf.
# Several gates identify a file by the SHA-256 of its bytes -- a prompt file, a
# repair configuration, a frozen decision request -- and a cache key is built
# from one of those digests. A checkout that rewrote the newlines of such a file
# would digest to something no frozen record names, so what the batch measured
# on one workstation would not reproduce on another. Pinning the checkout is
# what makes those digests a property of the repository rather than of the
# machine that cloned it.

prompts/**              text eol=lf
configs/**              text eol=lf
babeldoc*.toml          text eol=lf
spec_checks/**          text eol=lf
docs/**                 text=auto eol=lf

# A frozen copy of a prompt is a prompt: a replay reproduces a request by
# digesting one of these, so it carries the same pin as prompts/ itself.
examples/output/**/prompt_*/**  text eol=lf

# Unspecified on purpose, which leaves these to core.autocrlf. Each file under
# here is regenerated by a tool into a temporary directory and compared byte for
# byte against the tracked copy, and the tool writes the newline of the platform
# it runs on. Tracking the platform is therefore what keeps that comparison
# true, on every platform; pinning one newline would break it on the others.
# Moving these under the rule above means first moving the tools that write
# them, which is not a newline change.
docs/eval/results_*/**  !text !eol

# Payloads, never newline rewritten and never diffed as text.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.zip   binary
*.db    binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
