   "box_x": 143.815,
   "first_line_x": 143.815,
   "offset": 0.0,
   "lines": 1,
   "excerpt": "编辑们鼓励通过阅读来增进理解，但不对作者的观点表示支持。"
  },
  {
   "page": 8,
   "reference": "p8#3",
   "layout_label": "title",
