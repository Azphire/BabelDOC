{
  "taxonomy_version": "1.0",
  "description": "Magazine page type vocabulary. Every rule references a feature produced by babeldoc/magazine/page_features.py, compares it with one of ge/le/gt/lt against a threshold, and contributes its weight when satisfied. A type scores satisfied weight over total weight, so all scores lie in 0..1. Thresholds are tuning parameters: retune them here from the report produced by tools/page_classify_report.py, never in code.",
  "ambiguity_margin": 0.15,
  "default_type": "article_body",
  "page_types": [
    {
      "name": "front_cover",
      "description": "Opening cover: dominant image, a masthead-sized title, almost no running text.",
      "rules": [
        {"feature": "page_relative_position", "op": "le", "threshold": 0.02, "weight": 2.0},
        {"feature": "paragraph_count", "op": "le", "threshold": 12.0, "weight": 1.5},
        {"feature": "max_font_size_ratio", "op": "ge", "threshold": 2.0, "weight": 2.0},
        {"feature": "image_area_ratio", "op": "ge", "threshold": 0.3, "weight": 2.0},
        {"feature": "text_coverage_ratio", "op": "le", "threshold": 0.35, "weight": 1.0}
      ],
      "policy": {"chain_eligible": false, "translate": true, "repair_profile": "poster"}
    },
    {
      "name": "back_cover",
      "description": "Closing cover: last page of the issue, image led, very little text.",
      "rules": [
        {"feature": "page_relative_position", "op": "ge", "threshold": 0.9, "weight": 3.0},
        {"feature": "paragraph_count", "op": "le", "threshold": 12.0, "weight": 1.0},
        {"feature": "image_area_ratio", "op": "ge", "threshold": 0.25, "weight": 1.5},
        {"feature": "text_coverage_ratio", "op": "le", "threshold": 0.35, "weight": 1.0}
      ],
      "policy": {"chain_eligible": false, "translate": true, "repair_profile": "poster"}
    },
    {
      "name": "toc",
      "description": "Table of contents: entry titles with page numbers, often leader dots.",
      "rules": [
        {"feature": "numeric_token_density", "op": "ge", "threshold": 0.06, "weight": 2.0},
        {"feature": "short_paragraph_ratio", "op": "ge", "threshold": 0.55, "weight": 1.5},
        {"feature": "leader_dot_line_ratio", "op": "ge", "threshold": 0.08, "weight": 3.0},
        {"feature": "page_relative_position", "op": "le", "threshold": 0.15, "weight": 1.0}
      ],
      "policy": {"chain_eligible": false, "translate": true, "repair_profile": "grid"}
    },
    {
      "name": "masthead",
      "description": "Imprint and credits: staff lists, addresses, ISSN and copyright lines set small.",
      "rules": [
        {"feature": "numeric_token_density", "op": "ge", "threshold": 0.03, "weight": 1.5},
        {"feature": "short_paragraph_ratio", "op": "ge", "threshold": 0.5, "weight": 1.5},
        {"feature": "mean_paragraph_chars", "op": "le", "threshold": 120.0, "weight": 2.0},
        {"feature": "distinct_font_size_count", "op": "ge", "threshold": 3.0, "weight": 1.0},
        {"feature": "page_relative_position", "op": "le", "threshold": 0.2, "weight": 1.0}
      ],
      "policy": {"chain_eligible": false, "translate": true, "repair_profile": "grid"}
    },
    {
      "name": "editorial",
      "description": "Editor's letter near the front: one continuous argument in a narrow measure.",
      "rules": [
        {"feature": "page_relative_position", "op": "le", "threshold": 0.25, "weight": 2.0},
        {"feature": "mean_paragraph_chars", "op": "ge", "threshold": 180.0, "weight": 2.0},
        {"feature": "text_coverage_ratio", "op": "ge", "threshold": 0.3, "weight": 1.5},
        {"feature": "column_count_estimate", "op": "le", "threshold": 2.0, "weight": 1.0},
        {"feature": "max_font_size_ratio", "op": "ge", "threshold": 1.5, "weight": 1.0}
      ],
      "policy": {"chain_eligible": true, "translate": true, "repair_profile": "flow"}
    },
    {
      "name": "article_opener",
      "description": "First page of a feature: display title, lead image and a short standfirst.",
      "rules": [
        {"feature": "max_font_size_ratio", "op": "ge", "threshold": 2.0, "weight": 2.5},
        {"feature": "image_area_ratio", "op": "ge", "threshold": 0.25, "weight": 2.0},
        {"feature": "title_label_ratio", "op": "ge", "threshold": 0.08, "weight": 1.5},
        {"feature": "paragraph_count", "op": "le", "threshold": 20.0, "weight": 1.0},
        {"feature": "text_coverage_ratio", "op": "le", "threshold": 0.45, "weight": 1.0}
      ],
      "policy": {"chain_eligible": false, "translate": true, "repair_profile": "poster"}
    },
    {
      "name": "article_body",
      "description": "Continuation page of a feature: multi column running text at one size.",
      "rules": [
        {"feature": "text_coverage_ratio", "op": "ge", "threshold": 0.35, "weight": 2.0},
        {"feature": "mean_paragraph_chars", "op": "ge", "threshold": 150.0, "weight": 2.5},
        {"feature": "column_count_estimate", "op": "ge", "threshold": 2.0, "weight": 1.5},
        {"feature": "max_font_size_ratio", "op": "le", "threshold": 2.0, "weight": 1.5},
        {"feature": "short_paragraph_ratio", "op": "le", "threshold": 0.5, "weight": 1.5}
      ],
      "policy": {"chain_eligible": true, "translate": true, "repair_profile": "flow"}
    },
    {
      "name": "photo_spread",
      "description": "Full bleed picture page or double spread carrying only a caption.",
      "rules": [
        {"feature": "image_area_ratio", "op": "ge", "threshold": 0.5, "weight": 3.0},
        {"feature": "text_coverage_ratio", "op": "le", "threshold": 0.15, "weight": 2.0},
        {"feature": "paragraph_count", "op": "le", "threshold": 8.0, "weight": 1.5},
        {"feature": "mean_paragraph_chars", "op": "le", "threshold": 160.0, "weight": 1.0}
      ],
      "policy": {"chain_eligible": false, "translate": true, "repair_profile": "figure"}
    },
    {
      "name": "infographic",
      "description": "Data page: chart or map artwork surrounded by many short numeric labels.",
      "rules": [
        {"feature": "image_area_ratio", "op": "ge", "threshold": 0.25, "weight": 2.0},
        {"feature": "numeric_token_density", "op": "ge", "threshold": 0.08, "weight": 2.5},
        {"feature": "short_paragraph_ratio", "op": "ge", "threshold": 0.6, "weight": 2.0},
        {"feature": "mean_paragraph_chars", "op": "le", "threshold": 100.0, "weight": 1.5},
        {"feature": "paragraph_count", "op": "ge", "threshold": 8.0, "weight": 1.0}
      ],
      "policy": {"chain_eligible": false, "translate": true, "repair_profile": "figure"}
    },
    {
      "name": "interview",
      "description": "Question and answer page: alternating short prompts and longer replies in two type sizes.",
      "rules": [
        {"feature": "short_paragraph_ratio", "op": "ge", "threshold": 0.35, "weight": 2.0},
        {"feature": "mean_paragraph_chars", "op": "ge", "threshold": 120.0, "weight": 1.5},
        {"feature": "distinct_font_size_count", "op": "ge", "threshold": 3.0, "weight": 2.0},
        {"feature": "text_coverage_ratio", "op": "ge", "threshold": 0.3, "weight": 1.5},
        {"feature": "column_count_estimate", "op": "ge", "threshold": 2.0, "weight": 1.0}
      ],
      "policy": {"chain_eligible": true, "translate": true, "repair_profile": "flow"}
    },
    {
      "name": "sidebar_heavy",
      "description": "Page broken into boxed side stories: many columns and many type sizes at once.",
      "rules": [
        {"feature": "column_count_estimate", "op": "ge", "threshold": 3.0, "weight": 2.5},
        {"feature": "distinct_font_size_count", "op": "ge", "threshold": 4.0, "weight": 2.5},
        {"feature": "short_paragraph_ratio", "op": "ge", "threshold": 0.45, "weight": 1.5},
        {"feature": "text_coverage_ratio", "op": "ge", "threshold": 0.25, "weight": 1.0}
      ],
      "policy": {"chain_eligible": false, "translate": true, "repair_profile": "grid"}
    },
    {
      "name": "contributors",
      "description": "Author biographies with portraits, usually near the end of the issue.",
      "rules": [
        {"feature": "page_relative_position", "op": "ge", "threshold": 0.7, "weight": 2.0},
        {"feature": "short_paragraph_ratio", "op": "ge", "threshold": 0.6, "weight": 2.0},
        {"feature": "mean_paragraph_chars", "op": "le", "threshold": 140.0, "weight": 1.5},
        {"feature": "paragraph_count", "op": "ge", "threshold": 6.0, "weight": 1.0},
        {"feature": "image_area_ratio", "op": "ge", "threshold": 0.1, "weight": 1.0}
      ],
      "policy": {"chain_eligible": false, "translate": true, "repair_profile": "grid"}
    },
    {
      "name": "letters_page",
      "description": "Reader correspondence: several medium length signed items with no artwork.",
      "rules": [
        {"feature": "page_relative_position", "op": "le", "threshold": 0.3, "weight": 1.0},
        {"feature": "short_paragraph_ratio", "op": "ge", "threshold": 0.45, "weight": 2.0},
        {"feature": "mean_paragraph_chars", "op": "ge", "threshold": 80.0, "weight": 1.5},
        {"feature": "mean_paragraph_chars", "op": "le", "threshold": 220.0, "weight": 1.5},
        {"feature": "image_area_ratio", "op": "le", "threshold": 0.15, "weight": 1.5},
        {"feature": "paragraph_count", "op": "ge", "threshold": 6.0, "weight": 1.0}
      ],
      "policy": {"chain_eligible": false, "translate": true, "repair_profile": "flow"}
    },
    {
      "name": "advertisement",
      "description": "Bought page: single artwork with a slogan, no running text and one measure.",
      "rules": [
        {"feature": "image_area_ratio", "op": "ge", "threshold": 0.4, "weight": 2.5},
        {"feature": "text_coverage_ratio", "op": "le", "threshold": 0.2, "weight": 2.0},
        {"feature": "paragraph_count", "op": "le", "threshold": 6.0, "weight": 2.0},
        {"feature": "distinct_font_size_count", "op": "le", "threshold": 3.0, "weight": 1.0},
        {"feature": "column_count_estimate", "op": "le", "threshold": 1.0, "weight": 1.5}
      ],
      "policy": {"chain_eligible": false, "translate": true, "repair_profile": "figure"}
    },
    {
      "name": "section_divider",
      "description": "Section title page: a few display words on an otherwise empty page.",
      "rules": [
        {"feature": "paragraph_count", "op": "le", "threshold": 5.0, "weight": 2.5},
        {"feature": "title_label_ratio", "op": "ge", "threshold": 0.3, "weight": 2.0},
        {"feature": "max_font_size_ratio", "op": "ge", "threshold": 1.8, "weight": 1.5},
        {"feature": "text_coverage_ratio", "op": "le", "threshold": 0.15, "weight": 2.0}
      ],
      "policy": {"chain_eligible": false, "translate": true, "repair_profile": "poster"}
    }
  ]
}
