{
  "description": "Bounds for one deterministic minimal repair action. There is no model decision, loop, retry, cache, transport, or cross-article mutation.",
  "schema_version": "minimal-repair.v1",
  "max_actions_per_run": 1,
  "max_actions_per_run_allowed_range": "1..1",
  "actions": [
    "translate_orphan_text",
    "refit_or_reflow_owned_paragraph",
    "no_op"
  ],
  "issue_actions": {
    "untranslated_residue": "translate_orphan_text",
    "out_of_page": "refit_or_reflow_owned_paragraph",
    "text_text_collision": "refit_or_reflow_owned_paragraph",
    "fragment_cluster": "no_op",
    "chain_conservation": "no_op",
    "fixed_asset_drift": "no_op"
  },
  "translate_orphan_text": {
    "layout_labels": [
      "fallback_line"
    ],
    "min_residue_ratio": 0.9,
    "min_residue_ratio_allowed_range": "0.05..1.0",
    "min_source_chars": 12,
    "min_source_chars_allowed_range": "1..400"
  },
  "refit_or_reflow_owned_paragraph": {
    "eligible_roles": [
      "body",
      "text"
    ],
    "collision_max_area_ratio": 0.5,
    "collision_max_area_ratio_allowed_range": "0.05..0.95"
  },
  "asset_bbox_tolerance_pt": 0.000001,
  "asset_bbox_tolerance_pt_allowed_range": "0.0..0.01"
}
