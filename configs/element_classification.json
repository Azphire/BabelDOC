{
  "description": "Language-neutral paragraph role classification after final page-kind selection. Upstream body and caption labels are preserved as operational labels; title candidates are resolved from page policy, relative geometry, typography, and shared CJK/Latin punctuation. Every numeric decision threshold declares its calibration range.",

  "title_labels": ["title"],
  "body_labels": ["plain text", "text", "paragraph_hybrid"],
  "caption_labels": ["figure_caption", "table_caption"],
  "excluded_labels": ["abandon", "fallback_line"],
  "article_opener_kinds": ["article_opener"],

  "quote_openers": ["\"", "'", "“", "‘", "«", "《", "「", "『"],
  "quote_closers": ["\"", "'", "”", "’", "»", "》", "」", "』"],
  "sentence_enders": [".", "!", "?", "…", "。", "！", "？"],

  "opener_title_band_ratio": 0.3,
  "opener_title_band_ratio_allowed_range": "0.05..0.5",
  "top_title_band_ratio": 0.2,
  "top_title_band_ratio_allowed_range": "0.05..0.4",
  "body_region_top_ratio": 0.2,
  "body_region_top_ratio_allowed_range": "0.0..0.6",
  "body_region_bottom_ratio": 0.95,
  "body_region_bottom_ratio_allowed_range": "0.5..1.0",

  "main_title_min_font_ratio": 1.2,
  "main_title_min_font_ratio_allowed_range": "1.0..5.0",
  "main_cohort_font_tolerance_ratio": 0.12,
  "main_cohort_font_tolerance_ratio_allowed_range": "0.0..0.5",
  "main_cohort_top_tolerance_ratio": 0.1,
  "main_cohort_top_tolerance_ratio_allowed_range": "0.0..0.3",
  "continuation_font_tolerance_ratio": 0.15,
  "continuation_font_tolerance_ratio_allowed_range": "0.0..0.5",
  "continuation_line_delta_max": 1,
  "continuation_line_delta_max_allowed_range": "0..4",

  "byline_max_title_gap_ratio": 0.08,
  "byline_max_title_gap_ratio_allowed_range": "0.0..0.25",
  "byline_max_line_count": 3,
  "byline_max_line_count_allowed_range": "1..6",
  "byline_max_width_ratio": 0.55,
  "byline_max_width_ratio_allowed_range": "0.1..1.0",
  "byline_max_area_ratio": 0.05,
  "byline_max_area_ratio_allowed_range": "0.0..0.2",
  "byline_max_title_font_ratio": 0.85,
  "byline_max_title_font_ratio_allowed_range": "0.1..1.0",

  "pull_quote_min_font_ratio": 1.5,
