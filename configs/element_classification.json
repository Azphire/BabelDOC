  "pull_quote_max_width_ratio_allowed_range": "0.1..1.0",
  "pull_quote_max_area_ratio": 0.2,
  "pull_quote_max_area_ratio_allowed_range": "0.01..0.5",
  "sentence_min_characters": 18,
